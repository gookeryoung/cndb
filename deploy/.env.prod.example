# ═══════════════════════════════════════════════════════════════════
# cndb 生产环境变量模板
#
# 用法：cp deploy/.env.prod.example .env && vim .env
# 该文件含密钥，务必确认不在 git 追踪中（.gitignore 已含 .env）
# ═══════════════════════════════════════════════════════════════════

# ── 镜像地址（TCR）────────────────────────────────────────────
# 个人版：<registry>/<命名空间>/<仓库名>:<版本>
# 本项目实际使用：ccr.ccs.tencentyun.com/pydev/pydev
#
# deploy.sh 剥掉这里的版本段，再拼上流水线传入的新版本号，
# 所以升级版本无需改本文件。
CNDB_IMAGE=ccr.ccs.tencentyun.com/pydev/pydev:v0.3.0

# ── 服务监听 ──────────────────────────────────────────────────
# 默认 0.0.0.0:8000 对公网开放。
# 若前置 nginx / CLB，改为 127.0.0.1:8000:8000 只允许本机反代访问
CNDB_BIND=0.0.0.0:8000

# 数据卷名（换机器迁移时保持同名可直接挂载旧数据）
CNDB_VOLUME=cndb-data

# ── 安全（必填）────────────────────────────────────────────────
# JWT 签名密钥，生产必须替换默认值。生成：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

DEBUG=false
AUTH_ENABLED=true

# 跨域白名单。
# 必须是 JSON 数组字符串 —— Settings 里 CORS_ORIGINS 是 list[str]，
# pydantic-settings 对复杂类型环境变量按 JSON 解析。
# 写成逗号分隔的普通字符串会导致容器启动即崩（SettingsError）。
# 同域访问（前后端同一域名）可留空数组：[]
CORS_ORIGINS=["https://cndb.example.com"]

# ── 数据库 ────────────────────────────────────────────────────
# 默认 SQLite，库文件在卷内 /data/data/cndb.db
# 代码同时接受 CNDATABASE_URL 与 DATABASE_URL 两种写法（见 core/config.py）
CNDATABASE_URL=sqlite:////data/data/cndb.db

# ── COS 备份（可选，未配置则只做本地备份）──────────────────────
# 见 deploy/backup.sh。用 coscmd 上传归档到 COS
COS_ENABLE=false
COS_BUCKET=cndb-backup-1250000000
COS_REGION=ap-guangzhou
COS_PREFIX=cndb/
# SecretId / SecretKey 建议放 ~/.cos.conf（coscmd 默认路径，权限 600），
# 不要写进本文件
