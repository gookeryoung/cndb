# ═══════════════════════════════════════════════════════════════════
# cndb 生产环境变量模板
#
# 用法：cp deploy/.env.prod.example .env && vim .env
# 该文件含密钥，务必确认不在 git 追踪中（.gitignore 已含 .env）
# ═══════════════════════════════════════════════════════════════════

# ── 镜像地址（TCR）────────────────────────────────────────────
# 个人版：<registry>/<命名空间>/<仓库名>:<版本>
# 本项目实际使用：ccr.ccs.tencentyun.com/pydev/cndb
#
# deploy.sh 剥掉这里的版本段，再拼上流水线传入的新版本号，
# 所以升级版本无需改本文件。
CNDB_IMAGE=ccr.ccs.tencentyun.com/pydev/cndb:v0.3.0

# ── 服务监听 ──────────────────────────────────────────────────
# 默认 0.0.0.0:8000 对公网开放。
# 启用内置 nginx 反代（CNDB_ENABLE_PROXY=1）时**建议改成 127.0.0.1:8000**，
# 让应用只接受本机代理访问：外面直连应用端口会绕过代理，也能伪造客户端 IP。
CNDB_BIND=0.0.0.0:8000

# ── 反向代理（可选）─────────────────────────────────────────────
# 0 = 不启用（保持单容器，直接访问 CNDB_BIND）；1 = 启用 nginx 容器
# 启用后：deploy.sh 自动带 `--profile proxy`，部署末尾会做 **代理冒烟验证**
CNDB_ENABLE_PROXY=0
# 代理对外端口
CNDB_HTTP_BIND=80
CNDB_HTTPS_BIND=443
# 域名（未绑域名用下划线；绑域名时填例如 cndb.example.com）
CNDB_SERVER_NAME=_
# 上传体积上限（CSV 导入 / 备份恢复；默认 1m 会 413）
# ⚠️ 目前是「仅声明、未接线」：容器 nginx 的 envsubst 不会处理 snippets 目录
#    （见 deploy/nginx/snippets/cndb-proxy.conf 顶部说明），真正生效的值写死在
#    该片段里。要改上传上限请改那一行；此处保留仅为后续接入 envsubst 占位。
CNDB_MAX_BODY_SIZE=512m
# nginx 镜像：默认由构建源 profile 决定（CNDB_SOURCES=cn → docker.m.daocloud.io/library/nginx:1.27-alpine；
# global → 官方 nginx:1.27-alpine）。需要私有仓库 / 固定镜像时取消注释并显式指定。
# CNDB_NGINX_IMAGE=nginx:1.27-alpine
# 上游地址：**必须用容器名 cndb:8000，不要用 compose 服务名 app:8000**。
# 同机若有别的 compose 项目服务名也叫 app 并接入同一网络，Docker DNS 里 app 会
# round-robin 到多个容器，nginx 有概率连到隔壁项目 → 间歇 502/404。容器名全局唯一。
CNDB_APP_UPSTREAM=cndb:8000

# 数据卷名（换机器迁移时保持同名可直接挂载旧数据）
CNDB_VOLUME=cndb-data

# ── PPTX → PDF 衍生预览（ADR 0129）────────────────────────────
# 独立 pdf-worker 容器（仅内网、无发布端口）负责把 PPTX 转成可缓存的 PDF 预览件；
# 未配置 / 桌面端无容器时自动关闭，前端退回 0128 的客户端逐页渲染。
#
# worker 镜像地址：deploy.sh 每次部署会按应用版本自动改写；手工部署时可显式指定。
CNDB_PDF_WORKER_IMAGE=ccr.ccs.tencentyun.com/pydev/cndb-pdf-worker:v0.3.0
# 接口鉴权 token（app 与 worker 共用）：生成 openssl rand -hex 32
# 留空 = 不校验，仅适合本机调试；生产必须填写。
PPTX_PDF_CONVERTER_TOKEN=
# 转换器地址：默认指向 compose 服务名；留空 = 关闭服务端 PDF 预览。
PPTX_PDF_CONVERTER_URL=http://pdf-worker:8100
# worker 侧上限（与应用侧 PPTX_PDF_MAX_SOURCE_BYTES / PPTX_PDF_TIMEOUT_SECONDS 保持一致）
PPTX_PDF_WORKER_MAX_BYTES=104857600
PPTX_PDF_WORKER_TIMEOUT_SECONDS=180


# ── 安全（必填）────────────────────────────────────────────────
# JWT 签名密钥，生产必须替换默认值。生成：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

DEBUG=false
AUTH_ENABLED=true

# 跨域白名单。
# 必须是 JSON 数组字符串 —— Settings 里 CORS_ORIGINS 是 list[str]，
# pydantic-settings 对复杂类型环境变量按 JSON 解析。
# 写成逗号分隔的普通字符串会导致容器启动即崩（SettingsError）。
# 同域访问（前后端同一域名）可留空数组：[]
CORS_ORIGINS=["https://cndb.example.com"]

# ── 数据库 ────────────────────────────────────────────────────
# 默认 SQLite，库文件在卷内 /data/data/cndb.db
# 代码同时接受 CNDATABASE_URL 与 DATABASE_URL 两种写法（见 core/config.py）
CNDATABASE_URL=sqlite:////data/data/cndb.db

# ── COS 备份（可选，未配置则只做本地备份）──────────────────────
# 见 deploy/backup.sh。用 coscmd 上传归档到 COS
COS_ENABLE=false
COS_BUCKET=cndb-backup-1250000000
COS_REGION=ap-guangzhou
COS_PREFIX=cndb/
# SecretId / SecretKey 建议放 ~/.cos.conf（coscmd 默认路径，权限 600），
# 不要写进本文件
