# ═══════════════════════════════════════════════════════════════════
# cndb HTTP 反代（容器 nginx 的模板，官方镜像启动时用 envsubst 展开）
#
# 落点：/etc/nginx/templates/default.conf.template → /etc/nginx/conf.d/default.conf
# 可用变量（在 .env 中配置，见 deploy/.env.prod.example）：
#   CNDB_SERVER_NAME   server_name，未绑域名时用下划线
#   CNDB_APP_UPSTREAM  应用地址，默认 cndb:8000（**容器名，不要用服务名 app**）
#   CNDB_MAX_BODY_SIZE 上传体积上限，如 512m
#
# ⚠️ 不用 app:8000：Docker DNS 里服务名只在单个 compose 项目内唯一。若同机其他
#    项目也有服务名 app 并接入同一网络，app 会解析成多个 IP，nginx 会间歇打到
#    隔壁项目 → 502。容器名（container_name: cndb）全局唯一，是这里唯一安全的选择。
#
# 注意：官方镜像的 envsubst 只替换**环境里存在的**变量，
# 因此 nginx 自身的 $host / $uri / $request_time 等不会被误替换。
# ═══════════════════════════════════════════════════════════════════

# 上游（keepalive 减少上游握手开销）
upstream cndb_app {
    server ${CNDB_APP_UPSTREAM};
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${CNDB_SERVER_NAME};

    # certbot webroot（配 HTTPS 时用：certbot certonly --webroot -w /var/www/certbot）
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    # 反代规则 ——HTTP / HTTPS 共用同一份片段
    include /etc/nginx/snippets/cndb-proxy.conf;
}

# 可选扩展（HTTPS server 块等）：把 *.conf 放进 deploy/nginx/extra/ 即可生效；
# 目录为空时该通配 include 不会报错。示例见 extra/ssl.conf.example。
include /etc/nginx/extra/*.conf;
