# ═══════════════════════════════════════════════════════════════════
# cndb 依赖基础镜像（生产镜像的底座）
#
# 目的：把「装系统字体 + 装锁定依赖」这段慢且基本不变的工作固化成一个镜像。
# deploy.sh 按 requirements.lock.txt + 本文件内容的指纹打 tag
# （<镜像仓库>-base:deps-<hash>），发布时只在其上重建薄薄的 wheel 层：
#   · 常态发布：服务器构建 20-40s（不再重复 apt/pip）
#   · uv.lock 或本文件变化：多一次 1-3 分钟的基础镜像构建（一次性）
# 这样即使 Docker 层缓存被清，也只会重建薄层，不会再出现 5-15 分钟的冷启动。
#
# 构建上下文：仓库根目录（需要 dist/requirements.lock.txt）
#   docker build -f deploy/Dockerfile.base -t <registry>/<ns>/cndb-base:deps-<hash> .
# 正常发布由 deploy/deploy.sh 自动完成，无需手工执行。
# ═══════════════════════════════════════════════════════════════════

# 基础镜像默认 Docker Hub 官方源，可用 BUILD_BASE_IMAGE 经 --build-arg 覆盖。
# 生产建议钉 digest（python:3.12-slim@sha256:...），避免同名 tag 漂移导致基础层失效。
ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}

# ── 环境变量 ──
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Debian 软件源镜像主机：空表示直连官方源（global），国内走 mirrors.cloud.tencent.com。
# 由 deploy/docker-sources.sh 按 CNDB_SOURCES 注入，也可直接 --build-arg 覆盖。
ARG APT_MIRROR_HOST=""

# ── 系统依赖：仅中文字体 ──
# 字体只装 fonts-wqy-microhei（约 5MB）：pdf_fonts.py 按 fc-match 候选列表
# 动态注册，microhei 覆盖 GB2312/GBK 常用汉字，导出 Word/PDF 场景够用。
RUN set -eux; \
    if [ -n "${APT_MIRROR_HOST}" ]; then \
      sed -i \
        -e "s|deb.debian.org|${APT_MIRROR_HOST}|g" \
        -e "s|security.debian.org|${APT_MIRROR_HOST}|g" \
        /etc/apt/sources.list /etc/apt/sources.list.d/*.sources 2>/dev/null || true; \
    fi; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        fontconfig \
        fonts-wqy-microhei; \
    fc-cache -fv; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── 锁定依赖 ──
# requirements.lock.txt 由 uv export 从 uv.lock 生成（release 流水线自动产出）。
# PIP_INDEX_URL：默认官方源；服务器构建时 deploy.sh 默认传腾讯云 PyPI 内网镜像。
ARG PIP_INDEX_URL=https://pypi.org/simple
COPY dist/requirements.lock.txt ./
RUN pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" -r requirements.lock.txt
