# ═══════════════════════════════════════════════════════════════════
# cndb 生产镜像（腾讯云 TCR 版）
#
# 生产必需的几处设计：
#   1. 预建 /data 并授权给非 root 用户 —— 命名卷首次挂载会继承镜像内该目录
#      属主，否则 cndb 用户无法在卷上建 SQLite 库（Permission denied）。
#   2. 显式声明 CNDB_DATA_DIR=/data，使数据/附件/备份/日志全部落在同一挂载点。
#      若只设 DATABASE_URL，附件与备份会落在容器内 ~/.cndb，容器重建即丢失。
#   3. 内置 HEALTHCHECK，探测真实存在的 /api/health（镜像内无 curl，用 python）。
#   4. 安装中文字体（reportlab 生成 PDF / Jinja2 模板需要 CJK 字形，缺则渲染成方框）。
#
# 构建（服务器端，deploy CI 自动完成；手动构建需先准备产物）：
#   make build
#   uv export --frozen --no-hashes --no-dev --no-emit-project -o dist/requirements.lock.txt
#   docker build -f deploy/Dockerfile.prod -t <registry>/cndb:v0.3.0 .
# deploy.sh 在 SERVER_BUILD=1 下会自动完成构建与冒烟验证，CI 经 TAT 下发同步
# dist/ 与本文件到服务器后触发，见 .github/workflows/deploy-tencent.yml。
#
# 镜像源默认为官方源（Docker Hub / PyPI）；国内服务器直连超时时，可经
# BUILD_BASE_IMAGE / BUILD_PIP_INDEX_URL 换源（deploy.sh 透传，见下方 ARG 说明），
# 或在服务器 /etc/docker/daemon.json 配 registry-mirrors 透明加速。
# ═══════════════════════════════════════════════════════════════════

# 基础镜像默认 Docker Hub 官方源，可用 BUILD_BASE_IMAGE 经 --build-arg 覆盖。
ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}

# ── 环境变量 ──
# pip 源默认官方 PyPI，可用 BUILD_PIP_INDEX_URL 经 --build-arg 覆盖。
# 国内服务器如需加速，推荐腾讯云源（同步全、CVM 内网免流）；避免阿里云源
# （滞后镜像，常缺失较新版本包的 metadata 导致 404）。
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# ── 系统依赖：仅中文字体 ──
# 字体只装 fonts-wqy-microhei（约 5MB）：pdf_fonts.py 按 fc-match 候选列表
# 动态注册，microhei 覆盖 GB2312/GBK 常用汉字，导出 Word/PDF 场景够用。
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        fontconfig \
        fonts-wqy-microhei \
    && fc-cache -fv \
    && rm -rf /var/lib/apt/lists/*

# ── 安装 wheel（--no-cache-dir 减小镜像体积）──
WORKDIR /app

# 依赖层拆分：先装锁定依赖（requirements.lock.txt，由 uv export 从 uv.lock 生成，
# deploy CI 自动产出；本地构建见 make build），再装业务 wheel。
# 收益：版本升级时依赖版本不变，Docker 层缓存只重建薄薄的 wheel 层，
# 无需整层重装依赖。
# PIP_INDEX_URL：默认官方源，服务器构建可经 --build-arg 换腾讯云镜像（见头部说明）。
ARG PIP_INDEX_URL=https://pypi.org/simple
COPY dist/requirements.lock.txt ./
RUN pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" -r requirements.lock.txt

COPY dist/*.whl ./
RUN pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" ./*.whl \
    && rm ./*.whl requirements.lock.txt

# ── 非 root 用户 + 预建数据目录 ──
# /data 必须在此处 chown：Docker 创建命名卷时会复制镜像内该路径的属主，
# 权限不对则 SQLite 建库直接失败。
RUN useradd --create-home --shell /bin/bash --uid 1000 cndb \
    && mkdir -p /data \
    && chown -R cndb:cndb /app /data

# 数据根目录：所有可写数据（数据库/附件/备份/日志/缓存）统一落在此卷内
ENV CNDB_DATA_DIR=/data

USER cndb
WORKDIR /data
EXPOSE 8000

VOLUME ["/data"]

# 健康检查：探测真实存在的 /api/health（框架级路由，见 src/cndb/app.py）。
# 用 Python 标准库替代 curl（apt 层已不再安装 curl，省 ~8MB）：
# urlopen 对非 2xx 抛 HTTPError、对拒绝连接抛 URLError，均以非零退出，
# 语义与 curl -f 一致。
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD ["python", "-c", "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/api/health', timeout=5)"]

# uvicorn 启动：单进程足够，前端静态由 FastAPI 直接服务。
# --proxy-headers 配合 nginx 反代，让 request.client 拿到真实客户端 IP
# （公开分享 / 审计日志依赖）。
CMD ["uvicorn", "cndb.app:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
