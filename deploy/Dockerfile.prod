# ═══════════════════════════════════════════════════════════════════
# cndb 生产镜像（腾讯云 TCR 版）—— 应用层
#
# 依赖基础镜像由 deploy/Dockerfile.base 构建（系统字体 + 锁定依赖），本文件只做：
#   FROM <cndb-base:deps-<hash>>
#   → 装业务 wheel（MB 级）
#   → 建非 root 用户 / 预建 /data
# 常态发布只重建这两层，服务器构建通常 20-40s；依赖变化时才重建基础镜像。
#
# 生产必需的几处设计：
#   1. 预建 /data 并授权给非 root 用户 —— 命名卷首次挂载会继承镜像内该目录
#      属主，否则 cndb 用户无法在卷上建 SQLite 库（Permission denied）。
#   2. 显式声明 CNDB_DATA_DIR=/data，使数据/附件/备份/日志全部落在同一挂载点。
#      若只设 DATABASE_URL，附件与备份会落在容器内 ~/.cndb，容器重建即丢失。
#   3. 内置 HEALTHCHECK，探测真实存在的 /api/health（镜像内无 curl，用 python）。
#   4. 中文字体已在基础镜像里装好（reportlab 生成 PDF / Jinja2 模板需要 CJK 字形）。
#
# 构建（服务器端，deploy.sh 自动完成；手动构建需先准备基础镜像与 dist 产物）：
#   docker build -f deploy/Dockerfile.prod \
#     --build-arg BASE_IMAGE=<registry>/cndb-base:deps-<hash> \
#     -t <registry>/cndb:v0.3.0 .
# deploy.sh 在 SERVER_BUILD=1 下会自动复算指纹、复用/构建基础镜像，再构建本镜像。
#
# 基础镜像默认 Docker Hub 官方源，可用 BUILD_BASE_IMAGE 经 --build-arg 覆盖（见 Dockerfile.base）。
# ═══════════════════════════════════════════════════════════════════

# BASE_IMAGE 必须由 deploy.sh 传入（指向已构建/已缓存的 cndb-base 镜像）
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

WORKDIR /app

# ── 安装 wheel（依赖已在基础镜像里）──
# --no-index：禁止联网解析依赖。依赖若缺失会立刻失败，而不是构建到一半去 PyPI 慢拉，
# 也能保证「基础镜像内容」与「锁定清单」不一致时不会被静默放过。
# 顺手删掉基础镜像带过来的 requirements.lock.txt，不留在最终镜像里。
COPY dist/*.whl ./
RUN pip install --no-cache-dir --no-index ./*.whl \
    && rm -f ./*.whl requirements.lock.txt

# ── 非 root 用户 + 预建数据目录 ──
# /data 必须在此处 chown：Docker 创建命名卷时会复制镜像内该路径的属主，
# 权限不对则 SQLite 建库直接失败。
RUN useradd --create-home --shell /bin/bash --uid 1000 cndb \
    && mkdir -p /data \
    && chown -R cndb:cndb /app /data

# 数据根目录：所有可写数据（数据库/附件/备份/日志/缓存）统一落在此卷内
ENV CNDB_DATA_DIR=/data

USER cndb
WORKDIR /data
EXPOSE 8000

VOLUME ["/data"]

# 健康检查：探测真实存在的 /api/health（框架级路由，见 src/cndb/app.py）。
# 用 Python 标准库替代 curl（apt 层已不再安装 curl，省 ~8MB）：
# urlopen 对非 2xx 抛 HTTPError、对拒绝连接抛 URLError，均以非零退出，
# 语义与 curl -f 一致。
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD ["python", "-c", "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/api/health', timeout=5)"]

# uvicorn 启动：单进程足够，前端静态由 FastAPI 直接服务。
# --proxy-headers 配合 nginx 反代，让 request.client 拿到真实客户端 IP
# （公开分享 / 审计日志依赖）。
CMD ["uvicorn", "cndb.app:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
