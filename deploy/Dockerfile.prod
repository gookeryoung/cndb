# ═══════════════════════════════════════════════════════════════════
# cndb 生产镜像（腾讯云 TCR 版）
#
# 与早期 wheel 部署镜像的差异（均为生产必需的修复）：
#   1. 预建 /data 并授权给非 root 用户 —— 命名卷首次挂载时会继承镜像内
#      目录的属主，否则 cndb 用户无法在卷上建 SQLite 库（Permission denied）
#   2. 内置 HEALTHCHECK，探测真实存在的 /api/health
#      （旧 compose 探测 /health，该端点并不存在，会导致容器永远 unhealthy）
#   3. 显式声明 CNDB_DATA_DIR=/data，使 DATA_DIR / DATABASE_DIR /
#      UPLOAD_DIR / BACKUP_DIR 全部落在同一挂载点。
#      若只设 DATABASE_URL，附件与备份仍会落在容器内 ~/.cndb，
#      容器一重建历史附件全部丢失 —— 线上事故高发点。
#   4. 安装中文字体（reportlab 生成 PDF / Jinja2 报告模板需要 CJK 字形，
#      缺字体会渲染成方框）；只装 fonts-wqy-microhei，体积优先
#   5. HEALTHCHECK 与 compose healthcheck 均用 python 探测（镜像内无 curl）
#
# 构建（需先 make build 产出 dist/*.whl，再导出锁定依赖）：
#   make build
#   uv export --frozen --no-hashes --no-dev --no-emit-project -o dist/requirements.lock.txt
#   docker build -f deploy/Dockerfile.prod -t <registry>/cndb:v0.3.0 .
# （deploy CI 会自动完成导出步骤，见 .github/workflows/deploy-tencent.yml）
#
# 镜像源选择与构建位置强相关，改构建环境时务必同步检查：
#   - CI（GitHub Actions，境外 runner）：用 Docker Hub 官方源 + Debian 官方源 + PyPI 官方源
#   - 国内服务器本地构建：可换回 docker.m.daocloud.io与 mirrors.aliyun.com
# 但 PyPI 源即使是阿里云也不能用 —— 它缺包，会让构建 404（见下方 ENV 段）。
# 详见下方 FROM、ENV 与 apt 段的说明。
# ═══════════════════════════════════════════════════════════════════

# 基础镜像用Docker Hub 官方源，不要换国内加速站。
#
# 本文件早期写的是 docker.m.daocloud.io/python:3.12-slim，那是为「在国内服务器上
# 本地构建」选的源（当时服务器 Docker Hub 直连超时）。搬到 GitHub Actions 后，
# runner 在境外，访问国内镜像站要绕路，基础镜像拉取就可能把 20 分钟预算耗尽 ——
# 实测首次 CI 构建即因此超时。
# 结论：构建位置在哪，就用那侧最快的源。CI 在境外 → 官方源；服务器在国内 → 加速站。
FROM python:3.12-slim

# ── 环境变量 ──
# pip 用官方源，不用国内镜像。
#
# 曾用阿里云源并在注释里论证「包小请求碎、官方源在境外更慢」——那个判断错了。
# 阿里云是【滞后镜像】，实测缺失多个较新版本的包 metadata，构建必然失败：
#   pydantic-2.6.4      → 404（源里只有 2.6.0 / 2.6.1）
#   cryptography-42.0.8 → 404
# pip 会解析到满足约束的最新版本，而那个版本恰好是源里没有的，直接 404。
# 官方源包全，且 PyPI 走 CDN，境外 runner 实测不构成瓶颈。
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# ── 系统依赖：仅中文字体（reportlab 生成 PDF 需 CJK 字形）──
# apt 用官方 Debian 源，同上理由：境外 runner 访问国内 apt 源过慢。
#
# 字体只装 fonts-wqy-microhei（约 5MB），不再装 fonts-wqy-zenhei（约 16MB）：
#   - reports.py 按 fc-match 候选列表动态注册字体，"WenQuanYi Micro Hei"
#     在候选列表首位，删除 zenhei 后 PDF 渲染自动回退到 microhei；
#   - microhei（微米黑）覆盖 GB2312/GBK 常用汉字，报告与 PDF 场景够用。
# 健康检查不再依赖 curl：镜像内 python 足以探测 /api/health，apt 省 ~8MB。
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        fontconfig \
        fonts-wqy-microhei \
    && fc-cache -fv \
    && rm -rf /var/lib/apt/lists/*

# ── 安装 wheel（--no-cache-dir 减小镜像体积）──
WORKDIR /app

# 依赖层拆分：先装锁定依赖（requirements.lock.txt，由 uv export 从 uv.lock
# 生成，deploy CI 自动产出；本地构建执行
#   uv export --frozen --no-hashes --no-dev --no-emit-project -o dist/requirements.lock.txt
# ），再装业务 wheel。
# 收益：版本升级时依赖版本不变，TCR/Buildx 缓存只重建薄薄的 wheel 层
# （约 2MB），跨境增量拉取不再整层重传 ~180MB 的依赖。
# 附带收益：cffi/bcrypt 已随锁定清单装齐，pip 安装 wheel 时依赖全部满足、
# 无需在线解析，原先单独预装 cffi 规避 bcrypt 3.x 回溯失败的做法随之取消。
COPY dist/requirements.lock.txt ./
RUN pip install --no-cache-dir -r requirements.lock.txt

COPY dist/*.whl ./
RUN pip install --no-cache-dir ./*.whl \
    && rm ./*.whl requirements.lock.txt

# ── 非 root 用户 + 预建数据目录 ──
# /data 必须在此处 chown：Docker 创建命名卷时会复制镜像内该路径的属主，
# 权限不对则 SQLite 建库直接失败。
RUN useradd --create-home --shell /bin/bash --uid 1000 cndb \
    && mkdir -p /data \
    && chown -R cndb:cndb /app /data

# 数据根目录：所有可写数据（数据库/附件/备份/日志/缓存）统一落在此卷内
ENV CNDB_DATA_DIR=/data

USER cndb
WORKDIR /data
EXPOSE 8000

VOLUME ["/data"]

# 健康检查：探测真实存在的 /api/health（框架级路由，见 src/cndb/app.py）。
# 用 Python 标准库替代 curl（apt 层已不再安装 curl，省 ~8MB）：
# urlopen 对非 2xx 抛 HTTPError、对拒绝连接抛 URLError，均以非零退出，
# 语义与 curl -f 一致。
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD ["python", "-c", "import urllib.request as u; u.urlopen('http://127.0.0.1:8000/api/health', timeout=5)"]

# uvicorn 启动：单进程足够，前端静态由 FastAPI 直接服务。
# --proxy-headers 配合 nginx 反代，让 request.client 拿到真实客户端 IP
# （公开分享 / 审计日志依赖）。
CMD ["uvicorn", "cndb.app:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
