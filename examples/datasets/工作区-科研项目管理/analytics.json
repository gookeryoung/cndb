{
  "_comment": "科研项目管理分析模板种子：键为数据表名（= CSV 文件名），值为该表的预置分析模板。公式字段名须与表字段一致，config 支持 formulas / chart（含 aggregation 聚合方式）/ summary（分组汇总：group_by + metrics + sort_by + top_n）。",
  "科研项目": [
    {
      "name": "项目产出效率",
      "description": "自定义公式 paper_per_million=论文数/经费总额×1000（每千万元经费产出的论文数），散点图观察经费投入与论文产出的相关性；分组汇总按项目类别比较论文合计与平均产出效率。",
      "config": {
        "formulas": [
          {
            "key": "paper_per_million",
            "label": "每千万元论文数",
            "expr": "round([论文数] / [经费总额_万元] * 1000, 2)"
          }
        ],
        "chart": {
          "type": "scatter",
          "x": "经费总额_万元",
          "y": "论文数",
          "series": null,
          "title": "经费投入与论文产出",
          "aggregation": "sum"
        },
        "summary": {
          "group_by": "项目类别",
          "metrics": [
            {
              "field": "论文数",
              "agg": "sum",
              "label": "论文合计"
            },
            {
              "field": "paper_per_million",
              "agg": "avg",
              "label": "平均每千万元论文数"
            }
          ],
          "sort_by": "sum(论文数)",
          "sort_order": "desc",
          "top_n": 10
        },
        "fields": ["课题编号", "项目名称", "项目类别", "经费总额_万元", "论文数", "专利数"],
        "limit": 1000
      }
    },
    {
      "name": "按级别的经费与产出",
      "description": "按项目级别比较经费投入规模与专利产出：柱状图看各级别经费合计，分组汇总给出项目数、经费合计与专利合计，用于判断资源是否向高能级项目集中。",
      "config": {
        "formulas": [],
        "chart": {
          "type": "bar",
          "x": "项目级别",
          "y": "经费总额_万元",
          "series": null,
          "title": "各级别项目经费投入",
          "aggregation": "sum"
        },
        "summary": {
          "group_by": "项目级别",
          "metrics": [
            {
              "field": "课题编号",
              "agg": "count",
              "label": "项目数"
            },
            {
              "field": "经费总额_万元",
              "agg": "sum",
              "label": "经费合计(万元)"
            },
            {
              "field": "专利数",
              "agg": "sum",
              "label": "专利合计"
            }
          ],
          "sort_by": "sum(经费总额_万元)",
          "sort_order": "desc",
          "top_n": 10
        },
        "fields": ["课题编号", "项目类别", "项目级别", "经费总额_万元", "专利数"],
        "limit": 1000
      }
    }
  ],
  "科研经费": [
    {
      "name": "经费执行率分布",
      "description": "自定义公式 exec_rate=已支金额/预算金额×100，直方图查看各预算科目的执行率集中区间（识别执行偏慢与超支科目）；分组汇总按预算科目给出已拨合计与平均执行率。",
      "config": {
        "formulas": [
          {
            "key": "exec_rate",
            "label": "执行率(%)",
            "expr": "round([已支金额_万元] / [预算金额_万元] * 100, 2)"
          }
        ],
        "chart": {
          "type": "histogram",
          "x": "exec_rate",
          "y": null,
          "series": null,
          "title": "预算科目执行率分布",
          "aggregation": "sum"
        },
        "summary": {
          "group_by": "预算科目",
          "metrics": [
            {
              "field": "已拨金额_万元",
              "agg": "sum",
              "label": "已拨合计(万元)"
            },
            {
              "field": "exec_rate",
              "agg": "avg",
              "label": "平均执行率(%)"
            }
          ],
          "sort_by": "avg(exec_rate)",
          "sort_order": "desc",
          "top_n": 10
        },
        "fields": ["经费编号", "课题编号", "预算科目", "预算金额_万元", "已拨金额_万元", "已支金额_万元"],
        "limit": 1000
      }
    }
  ],
  "项目进展": [
    {
      "name": "阶段进度分布",
      "description": "箱线图比较各进展阶段的进度百分比离散程度，识别阶段推进是否均衡；分组汇总按阶段给出平均进度与报告条数，用于季度例会讲评。",
      "config": {
        "formulas": [],
        "chart": {
          "type": "boxplot",
          "x": "进展阶段",
          "y": "进度百分比",
          "series": null,
          "title": "各阶段进度分布",
          "aggregation": "sum"
        },
        "summary": {
          "group_by": "进展阶段",
          "metrics": [
            {
              "field": "进度百分比",
              "agg": "avg",
              "label": "平均进度(%)"
            },
            {
              "field": "进展编号",
              "agg": "count",
              "label": "报告条数"
            }
          ],
          "sort_by": "avg(进度百分比)",
          "sort_order": "desc",
          "top_n": 10
        },
        "fields": ["进展编号", "课题编号", "报告季度", "进展阶段", "进度百分比"],
        "limit": 1000
      }
    }
  ]
}
