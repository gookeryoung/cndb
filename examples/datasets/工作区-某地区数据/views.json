{
  "_comment": "视图种子配置：按 表名 -> 视图列表 组织。字段名必须与 CSV 建表时的 DataField.name 一致。看板视图可通过 view_options.card_sort_field 配置列内卡片排序。",
  "房价预测": [
    {
      "name": "全部",
      "view_type": "grid",
      "sortings": [
        {
          "field_name": "房价_万元",
          "direction": "desc"
        }
      ],
      "is_default": true,
      "order": 0
    },
    {
      "name": "学区房",
      "view_type": "grid",
      "filter_type": "AND",
      "filters": [
        {
          "field_name": "是否学区房",
          "op": "=",
          "value": "1"
        }
      ],
      "sortings": [
        {
          "field_name": "房价_万元",
          "direction": "desc"
        }
      ],
      "order": 1
    },
    {
      "name": "近地铁",
      "view_type": "grid",
      "filter_type": "AND",
      "filters": [
        {
          "field_name": "是否近地铁",
          "op": "=",
          "value": "1"
        }
      ],
      "sortings": [
        {
          "field_name": "房价_万元",
          "direction": "desc"
        }
      ],
      "order": 2
    },
    {
      "name": "按城市看板",
      "view_type": "kanban",
      "view_options": {
        "group_field": "城市",
        "title_field": "面积_平米",
        "card_sort_field": "房价_万元",
        "card_sort_direction": "desc",
        "pin_urgent": false
      },
      "order": 3
    },
    {
      "name": "豪宅榜",
      "view_type": "grid",
      "filter_type": "AND",
      "filters": [
        {
          "field_name": "房价_万元",
          "op": ">=",
          "value": "200"
        }
      ],
      "sortings": [
        {
          "field_name": "房价_万元",
          "direction": "desc"
        }
      ],
      "order": 4
    },
    {
      "name": "房价分析概览",
      "view_type": "chart",
      "view_options": {
        "charts": [
          {
            "chart_type": "scatter",
            "x_field": "房龄_年",
            "y_field": "房价_万元",
            "show_trend_line": true,
            "show_stats_panel": true
          },
          {
            "chart_type": "boxplot",
            "dimension_field": "城市",
            "measure_field": "房价_万元",
            "show_stats_panel": true
          },
          {
            "chart_type": "scatter",
            "x_field": "房间数",
            "y_field": "房价_万元",
            "show_stats_panel": true
          }
        ]
      },
      "order": 5
    }
  ],
  "气温天气": [
    {
      "name": "全部",
      "view_type": "grid",
      "sortings": [
        {
          "field_name": "日期",
          "direction": "desc"
        }
      ],
      "is_default": true,
      "order": 0
    },
    {
      "name": "晴好天气",
      "view_type": "grid",
      "filter_type": "AND",
      "filters": [
        {
          "field_name": "天气",
          "op": "=",
          "value": "晴"
        }
      ],
      "sortings": [
        {
          "field_name": "日期",
          "direction": "desc"
        }
      ],
      "order": 1
    },
    {
      "name": "按城市看板",
      "view_type": "kanban",
      "view_options": {
        "group_field": "城市",
        "title_field": "天气",
        "due_date_field": "日期",
        "card_sort_field": "最高温_℃",
        "card_sort_direction": "desc",
        "pin_urgent": false
      },
      "order": 2
    },
    {
      "name": "高温预警",
      "view_type": "grid",
      "filter_type": "AND",
      "filters": [
        {
          "field_name": "最高温_℃",
          "op": ">=",
          "value": "30"
        }
      ],
      "sortings": [
        {
          "field_name": "最高温_℃",
          "direction": "desc"
        }
      ],
      "order": 3
    },
    {
      "name": "城市气候概览",
      "view_type": "chart",
      "view_options": {
        "charts": [
          {
            "chart_type": "line",
            "dimension_field": "日期",
            "date_granularity": "month",
            "measure_field": "最高温_℃",
            "aggregation": "avg",
            "group_field": "城市",
            "show_stats_panel": true
          },
          {
            "chart_type": "boxplot",
            "dimension_field": "城市",
            "measure_field": "风速_m/s",
            "show_stats_panel": true
          }
        ]
      },
      "order": 4
    }
  ]
}
