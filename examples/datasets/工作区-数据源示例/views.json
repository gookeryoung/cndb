        "tag_fields": ["政策类型", "风险等级"],
        "meta_fields": ["发文机构"],
        "date_field": "日期",
        "card_size": "medium",
        "summary_lines": 4
      },
      "sortings": [
        {"field_name": "日期", "direction": "desc"},
        {"field_name": "标题", "direction": "asc"}
      ],
      "is_default": true,
      "order": 0
    },
    {
      "name": "全部政策",
      "view_type": "grid",
      "sortings": [
        {"field_name": "日期", "direction": "desc"},
        {"field_name": "标题", "direction": "asc"}
      ],
      "order": 1
    },
    {
      "name": "按发文机构看板",
      "view_type": "kanban",
      "view_options": {
        "group_field": "发文机构",
        "title_field": "标题",
        "priority_field": "风险等级",
        "card_fields": ["政策类型", "生效日期"]
      },
      "order": 2
    },
    {
      "name": "待落实政策",
      "view_type": "grid",
      "filter_type": "AND",
      "filters": [
        {"field_name": "落实状态", "op": "=", "value": "待落实"}
      ],
      "sortings": [
        {"field_name": "生效日期", "direction": "asc"},
        {"field_name": "标题", "direction": "asc"}
      ],
      "order": 3
    },
    {
      "name": "政策类型与风险概览",
      "view_type": "chart",
      "view_options": {
        "charts": [
          {
            "chart_type": "bar",
            "dimension_field": "政策类型",
            "measure_field": "标题",
            "aggregation": "count"
          },
          {
            "chart_type": "pie",
            "dimension_field": "风险等级",
            "measure_field": "标题",
            "aggregation": "count"
          }
        ]
      },
      "order": 4
    }
  ]
}
