    {
      "name": "议题与态势分布",
      "view_type": "chart",
      "view_options": {
        "charts": [
          {
            "chart_type": "pie",
            "dimension_field": "主题",
            "measure_field": "标题",
            "aggregation": "count"
          },
          {
            "chart_type": "bar",
            "dimension_field": "趋势判断",
            "measure_field": "标题",
            "aggregation": "count"
          }
        ]
      },
      "order": 5
    },
    {
      "name": "升温议题",
      "view_type": "grid",
      "filter_type": "AND",
      "filters": [
        {"field_name": "趋势判断", "op": "=", "value": "升温"}
      ],
      "sortings": [
        {"field_name": "日期", "direction": "desc"},
        {"field_name": "标题", "direction": "asc"}
      ],
      "order": 6
