{
  "股市日线": [
    {
      "name": "全部日线",
      "view_type": "grid",
      "sortings": [
        {"field_name": "股票代码", "direction": "asc"},
        {"field_name": "日期", "direction": "desc"}
      ],
      "is_default": true,
      "order": 0
    }
  ],
  "天气每日": [
    {
      "name": "全部",
      "view_type": "grid",
      "sortings": [
        {"field_name": "日期", "direction": "asc"},
        {"field_name": "城市", "direction": "asc"}
      ],
      "is_default": true,
      "order": 0
    },
    {
      "name": "高温日（≥35℃）",
      "view_type": "grid",
      "filter_type": "AND",
      "filters": [
        {"field_name": "最高气温", "op": ">=", "value": 35}
      ],
      "sortings": [
        {"field_name": "最高气温", "direction": "desc"}
      ],
      "order": 1
    },
    {
      "name": "降雨日",
      "view_type": "grid",
      "filter_type": "AND",
      "filters": [
        {"field_name": "降水量", "op": ">", "value": 0}
      ],
      "sortings": [
        {"field_name": "降水量", "direction": "desc"}
      ],
      "order": 2
    }
  ],
  "国际形势发展动态": [
    {
      "name": "资讯画廊",
      "view_type": "gallery",
      "view_options": {
        "title_field": "标题",
        "summary_field": "摘要",
        "tag_fields": ["地区", "主题", "趋势判断"],
        "meta_fields": ["来源"],
        "date_field": "日期",
        "card_size": "medium",
        "summary_lines": 3
      },
      "sortings": [
        {"field_name": "日期", "direction": "desc"},
        {"field_name": "标题", "direction": "asc"}
      ],
      "is_default": true,
      "order": 0
    },
    {
      "name": "全部资讯",
      "view_type": "grid",
      "sortings": [
        {"field_name": "日期", "direction": "desc"},
        {"field_name": "标题", "direction": "asc"}
      ],
      "order": 1
    },
    {
      "name": "态势看板",
      "view_type": "kanban",
      "view_options": {
        "group_field": "趋势判断",
        "title_field": "标题",
        "priority_field": "主题",
        "card_fields": ["地区", "日期"]
      },
      "order": 2
    },
    {
      "name": "地区议题矩阵",
      "view_type": "matrix",
      "view_options": {
        "row_field": "地区",
        "column_field": "主题",
        "title_field": "标题"
      },
      "order": 3
    },
    {
      "name": "每日简报日历",
      "view_type": "calendar",
      "view_options": {
        "start_field": "日期",
        "title_field": "标题",
        "group_field": "主题"
      },
      "order": 4
    },
    {
      "name": "议题与态势分布",
      "view_type": "chart",
      "view_options": {
        "charts": [
          {
            "chart_type": "pie",
            "dimension_field": "主题",
            "measure_field": "标题",
            "aggregation": "count"
          },
          {
            "chart_type": "bar",
            "dimension_field": "趋势判断",
            "measure_field": "标题",
            "aggregation": "count"
          }
        ]
      },
      "order": 5
    },
    {
      "name": "升温议题",
      "view_type": "grid",
      "filter_type": "AND",
      "filters": [
        {"field_name": "趋势判断", "op": "=", "value": "升温"}
      ],
      "sortings": [
        {"field_name": "日期", "direction": "desc"},
        {"field_name": "标题", "direction": "asc"}
      ],
      "order": 6
    }
  ],
  "行业政策与合规台账": [
    {
      "name": "政策台账画廊",
      "view_type": "gallery",
      "view_options": {
        "title_field": "标题",
