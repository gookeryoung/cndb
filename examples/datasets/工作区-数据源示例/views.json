{
  "_comment": "视图种子配置：数据源示例工作区。天气每日按日期升序（时序自然序）并附高温日过滤视图；股市日线按交易日降序（最新在前）并附放量日过滤视图。字段名须与 CSV 表头一致。",
  "天气每日": [
    {
      "name": "全部",
      "view_type": "grid",
      "sortings": [
        {"field_name": "日期", "direction": "asc"},
        {"field_name": "城市", "direction": "asc"}
      ],
      "is_default": true,
      "order": 0
    },
    {
      "name": "高温日（≥35℃）",
      "view_type": "grid",
      "filter_type": "AND",
      "filters": [
        {"field_name": "最高气温", "op": ">=", "value": 35}
      ],
      "sortings": [
        {"field_name": "最高气温", "direction": "desc"}
      ],
      "order": 1
    },
    {
      "name": "降雨日",
      "view_type": "grid",
      "filter_type": "AND",
      "filters": [
        {"field_name": "降水量", "op": ">", "value": 0}
      ],
      "sortings": [
        {"field_name": "降水量", "direction": "desc"}
      ],
      "order": 2
    }
  ],
  "股市日线": [
    {
      "name": "全部",
      "view_type": "grid",
      "sortings": [
        {"field_name": "交易日", "direction": "desc"},
        {"field_name": "股票代码", "direction": "asc"}
      ],
      "is_default": true,
      "order": 0
    },
    {
      "name": "放量日（≥1.5亿股）",
      "view_type": "grid",
      "filter_type": "AND",
      "filters": [
        {"field_name": "成交量", "op": ">=", "value": 150000000}
      ],
      "sortings": [
        {"field_name": "成交量", "direction": "desc"}
      ],
      "order": 1
    }
  ]
}
