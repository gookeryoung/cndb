      "view_options": {
        "group_field": "趋势判断",
        "title_field": "标题",
        "priority_field": "主题",
        "card_fields": ["地区", "日期"]
      },
      "order": 2
    },
    {
      "name": "地区议题矩阵",
      "view_type": "matrix",
      "view_options": {
        "row_field": "地区",
        "column_field": "主题",
