{
  "天气每日": [
    {
      "name": "全部",
      "view_type": "grid",
      "sortings": [
        {"field_name": "日期", "direction": "asc"},
        {"field_name": "城市", "direction": "asc"}
      ],
      "is_default": true,
      "order": 0
    },
    {
      "name": "高温日（≥35℃）",
      "view_type": "grid",
      "filter_type": "AND",
      "filters": [
        {"field_name": "最高气温", "op": ">=", "value": 35}
      ],
      "sortings": [
        {"field_name": "最高气温", "direction": "desc"}
      ],
      "order": 1
    },
    {
      "name": "降雨日",
      "view_type": "grid",
      "filter_type": "AND",
      "filters": [
        {"field_name": "降水量", "op": ">", "value": 0}
      ],
      "sortings": [
        {"field_name": "降水量", "direction": "desc"}
      ],
      "order": 2
    }
  ],
  "国际形势发展动态": [
