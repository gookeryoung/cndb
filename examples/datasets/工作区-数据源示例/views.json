      "view_options": {
        "title_field": "标题",
        "summary_field": "摘要",
        "tag_fields": ["地区", "主题", "趋势判断"],
        "meta_fields": ["来源"],
        "date_field": "日期",
        "card_size": "medium",
        "summary_lines": 3
      },
      "sortings": [
        {"field_name": "日期", "direction": "desc"},
        {"field_name": "标题", "direction": "asc"}
      ],
      "is_default": true,
      "order": 0
