          "name": "合规要求",
          "field_type": "text"
        },
        "适用部门": {
          "name": "适用部门",
          "field_type": "text"
        },
        "风险等级": {
          "name": "风险等级",
          "field_type": "text"
        },
        "落实状态": {
          "name": "落实状态",
          "field_type": "text"
        },
