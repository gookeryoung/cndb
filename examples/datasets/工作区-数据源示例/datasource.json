    },
    {
      "name": "行业政策与合规台账（大模型动态拉取）",
      "provider": "llm_prompt",
      "table": "行业政策与合规台账",
      "request_spec": {
        "prompt": {
          "user_template": "请梳理 {today} 前后的行业政策与合规要求，覆盖数据安全、个人信息保护、财务合规、市场监管、人力资源与生态环境等主题，至少 8 条。\n每条记录给出：日期、发文机构、政策类型、标题、摘要、合规要求、适用部门、风险等级、落实状态、生效日期、链接。\n字段名用中文，不要翻译或转写：日期（YYYY-MM-DD）、发文机构、政策类型（办法/通知/规划/征求意见）、标题、摘要（不超过 150 字）、合规要求（一句话说明企业需要做什么）、适用部门、风险等级（高/中/低）、落实状态（已落实/推进中/待落实）、生效日期（YYYY-MM-DD）、链接（原文链接，无法确认用空字符串）。\n无法核实的摘要与来源标注「综合整理」，不要编造链接，不要返回空数组。\n同一天同一发文机构同一标题只保留一条记录（日期 + 发文机构 + 标题 为去重键）。\n只输出 JSON：一个行对象数组；如需包裹，使用 {\"rows\": [行对象, ...]}。不要输出 Markdown 代码围栏或解释文字。"
        },
        "llm": {
          "temperature": 0.5,
          "max_tokens": 4096,
          "json_mode": true
        }
      },
      "entrant_keys": [],
      "match_keys": [
        "日期",
        "发文机构",
        "标题"
      ],
      "field_mapping": {
        "日期": {
          "name": "日期",
          "field_type": "date"
        },
        "发文机构": {
          "name": "发文机构",
          "field_type": "text"
        },
        "政策类型": {
          "name": "政策类型",
          "field_type": "text"
        },
        "标题": {
          "name": "标题",
          "field_type": "text"
        },
        "摘要": {
          "name": "摘要",
          "field_type": "text"
        },
        "合规要求": {
          "name": "合规要求",
          "field_type": "text"
        },
        "适用部门": {
          "name": "适用部门",
          "field_type": "text"
        },
        "风险等级": {
          "name": "风险等级",
          "field_type": "text"
        },
        "落实状态": {
          "name": "落实状态",
          "field_type": "text"
        },
        "生效日期": {
          "name": "生效日期",
          "field_type": "date"
        },
        "链接": {
          "name": "链接",
          "field_type": "text"
        }
      },
      "cursor": {
        "strategy": "none"
      },
      "schedule": {
        "mode": "manual"
      },
      "enabled": true,
      "rate_limit_ms": 0
    },
    {
      "name": "国际形势发展动态（大模型动态拉取）",
      "provider": "llm_prompt",
      "table": "国际形势发展动态",
      "request_spec": {
        "prompt": {
          "user_template": "请梳理 {today} 的国际形势发展动态，覆盖大国关系、地区冲突、全球经济与贸易、多边机制与外交活动，地区覆盖亚太、欧洲、中东、北美、非洲、拉美。\n每条记录给出：日期、地区、主题、标题、摘要、来源、链接、趋势判断。\n字段名用中文，不要翻译或改写：日期（YYYY-MM-DD）、地区（地区或国家）、主题（主题分类）、标题、摘要（不超过 150 字）、来源（来源媒体）、链接（原文链接，无法确认用空字符串）、趋势判断（缓和/升温/僵持/不确定）。\n无法核实的摘要与来源标注「综合整理」，不要编造链接，不要返回空数组。\n同一天同一地区同一标题只保留一条记录（日期 + 地区 + 标题 为去重键）。\n只输出 JSON：一个行对象数组；如需包裹，使用 {\"rows\": [行对象, ...]}。不要输出 Markdown 代码围栏或解释文字。"
        },
        "llm": {
          "temperature": 0.5,
          "max_tokens": 4096,
          "json_mode": true
        }
      },
