      "entrant_source": {"table": "股票清单", "field": "代码", "prefix_in": ["sh5", "sz1"]},
      "match_keys": ["股票代码", "日期", "来源"],
      "field_mapping": {
        "symbol": {"name": "股票代码", "field_type": "text"},
