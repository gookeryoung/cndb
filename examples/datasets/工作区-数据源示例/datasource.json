{
  "_comment": "数据源同步任务种子：数据源示例工作区。适配器只保留通用项（http_json / llm_prompt）：「股市日线」为新浪（不复权）+ 腾讯（前复权）双源同步到同一张本地表（provider=http_json，按「股票代码 + 日期 + 来源」幂等，腾讯成交量由手换算为股）；「行业政策与合规台账」「国际形势发展动态」为两组大模型动态拉取任务（provider=llm_prompt）。全部任务调度的 manual，演示时点「立即运行」；llm_prompt 需先配置个人「大模型连接」的 API Key。表内字段与视图、示例 CSV 全部为中文，字段映射/幂等键也用中文。",
  "jobs": [
    {
      "name": "股市日线（新浪 · 不复权）",
      "provider": "http_json",
      "table": "股市日线",
      "request_spec": {
        "url_template": "https://money.finance.sina.com.cn/quotes_service/api/json_v2.php/CN_MarketData.getKLineData?symbol={entrant}&scale=240&ma=no&datalen=1023",
        "record_mode": "rows",
        "row_defaults": {
          "来源": "新浪",
          "复权方式": "不复权"
        }
      },
      "entrant_param": "symbol",
      "entrant_keys": [
        "sh600519",
        "sz000001"
      ],
      "match_keys": [
        "股票代码",
        "日期",
        "来源"
      ],
      "field_mapping": {
        "symbol": {
          "name": "股票代码",
          "field_type": "text"
        },
        "day": {
          "name": "日期",
          "field_type": "date"
        },
        "open": {
          "name": "开盘",
          "field_type": "float"
        },
        "close": {
          "name": "收盘",
          "field_type": "float"
        },
        "high": {
          "name": "最高",
          "field_type": "float"
        },
        "low": {
          "name": "最低",
          "field_type": "float"
        },
        "volume": {
          "name": "成交量",
          "field_type": "number"
        }
      },
      "cursor": {
        "strategy": "none"
      },
      "schedule": {
        "mode": "manual"
      },
      "enabled": true,
      "rate_limit_ms": 200
    },
    {
      "name": "股市日线（腾讯 · 前复权）",
      "provider": "http_json",
      "table": "股市日线",
      "request_spec": {
        "url_template": "https://proxy.finance.qq.com/ifzqgtimg/appstock/app/newfqkline/get?param={entrant},day,{start},{end},320,qfq",
        "record_mode": "rows_array",
        "data_path": "data.{entrant}.qfqday",
        "record_layout": {
          "日期": 0,
          "开盘": 1,
          "收盘": 2,
          "最高": 3,
          "最低": 4,
          "成交量": 5
        },
        "row_defaults": {
          "来源": "腾讯",
          "复权方式": "前复权"
        },
        "time_window": {
          "mode": "range",
          "chunk_days": 0
        }
      },
      "entrant_param": "symbol",
      "entrant_keys": [
        "sh600519",
        "sz000001"
      ],
      "match_keys": [
        "股票代码",
        "日期",
        "来源"
      ],
      "field_mapping": {
        "symbol": {
          "name": "股票代码",
          "field_type": "text"
        },
        "日期": {
          "name": "日期",
          "field_type": "date"
        },
        "开盘": {
          "name": "开盘",
          "field_type": "float"
        },
        "收盘": {
          "name": "收盘",
          "field_type": "float"
        },
        "最高": {
          "name": "最高",
          "field_type": "float"
        },
        "最低": {
          "name": "最低",
          "field_type": "float"
        },
        "成交量": {
          "name": "成交量",
          "field_type": "number",
          "scale": 100
        }
      },
      "cursor": {
        "strategy": "date",
        "field": "日期",
        "backfill_start": "2026-01-01"
      },
      "schedule": {
        "mode": "manual"
      },
      "enabled": true,
      "rate_limit_ms": 200
    },
    {
      "name": "行业政策与合规台账（大模型动态拉取）",
      "provider": "llm_prompt",
      "table": "行业政策与合规台账",
      "request_spec": {
        "prompt": {
          "user_template": "请梳理 {today} 前后的行业政策与合规要求，覆盖数据安全、个人信息保护、财务合规、市场监管、人力资源与生态环境等主题，至少 8 条。\n每条记录给出：日期、发文机构、政策类型、标题、摘要、合规要求、适用部门、风险等级、落实状态、生效日期、链接。\n字段名用中文，不要翻译或转写：日期（YYYY-MM-DD）、发文机构、政策类型（办法/通知/规划/征求意见）、标题、摘要（不超过 150 字）、合规要求（一句话说明企业需要做什么）、适用部门、风险等级（高/中/低）、落实状态（已落实/推进中/待落实）、生效日期（YYYY-MM-DD）、链接（原文链接，无法确认用空字符串）。\n无法核实的摘要与来源标注「综合整理」，不要编造链接，不要返回空数组。\n同一天同一发文机构同一标题只保留一条记录（日期 + 发文机构 + 标题 为去重键）。\n只输出 JSON：一个行对象数组；如需包裹，使用 {\"rows\": [行对象, ...]}。不要输出 Markdown 代码围栏或解释文字。"
        },
        "llm": {
          "temperature": 0.5,
          "max_tokens": 4096,
          "json_mode": true
        }
      },
      "entrant_keys": [],
      "match_keys": [
        "日期",
        "发文机构",
        "标题"
      ],
      "field_mapping": {
        "日期": {
          "name": "日期",
          "field_type": "date"
        },
        "发文机构": {
          "name": "发文机构",
          "field_type": "text"
        },
        "政策类型": {
          "name": "政策类型",
          "field_type": "text"
        },
        "标题": {
          "name": "标题",
          "field_type": "text"
        },
        "摘要": {
          "name": "摘要",
          "field_type": "text"
        },
        "合规要求": {
          "name": "合规要求",
          "field_type": "text"
        },
        "适用部门": {
          "name": "适用部门",
          "field_type": "text"
        },
        "风险等级": {
          "name": "风险等级",
          "field_type": "text"
        },
        "落实状态": {
          "name": "落实状态",
          "field_type": "text"
        },
        "生效日期": {
          "name": "生效日期",
          "field_type": "date"
        },
        "链接": {
          "name": "链接",
          "field_type": "text"
        }
      },
      "cursor": {
        "strategy": "none"
      },
      "schedule": {
        "mode": "manual"
      },
      "enabled": true,
      "rate_limit_ms": 0
    },
    {
      "name": "国际形势发展动态（大模型动态拉取）",
      "provider": "llm_prompt",
      "table": "国际形势发展动态",
      "request_spec": {
        "prompt": {
          "user_template": "请梳理 {today} 的国际形势发展动态，覆盖大国关系、地区冲突、全球经济与贸易、多边机制与外交活动，地区覆盖亚太、欧洲、中东、北美、非洲、拉美。\n每条记录给出：日期、地区、主题、标题、摘要、来源、链接、趋势判断。\n字段名用中文，不要翻译或改写：日期（YYYY-MM-DD）、地区（地区或国家）、主题（主题分类）、标题、摘要（不超过 150 字）、来源（来源媒体）、链接（原文链接，无法确认用空字符串）、趋势判断（缓和/升温/僵持/不确定）。\n无法核实的摘要与来源标注「综合整理」，不要编造链接，不要返回空数组。\n同一天同一地区同一标题只保留一条记录（日期 + 地区 + 标题 为去重键）。\n只输出 JSON：一个行对象数组；如需包裹，使用 {\"rows\": [行对象, ...]}。不要输出 Markdown 代码围栏或解释文字。"
        },
        "llm": {
          "temperature": 0.5,
          "max_tokens": 4096,
          "json_mode": true
        }
      },
      "entrant_keys": [],
      "match_keys": [
        "日期",
        "地区",
        "标题"
      ],
      "field_mapping": {
        "日期": {
          "name": "日期",
          "field_type": "date"
        },
        "地区": {
          "name": "地区",
          "field_type": "text"
        },
        "主题": {
          "name": "主题",
          "field_type": "text"
        },
        "标题": {
          "name": "标题",
          "field_type": "text"
        },
        "摘要": {
          "name": "摘要",
          "field_type": "text"
        },
        "来源": {
          "name": "来源",
          "field_type": "text"
        },
        "链接": {
          "name": "链接",
          "field_type": "text"
        },
        "趋势判断": {
          "name": "趋势判断",
          "field_type": "text"
        }
      },
      "cursor": {
        "strategy": "none"
      },
      "schedule": {
        "mode": "manual"
      },
      "enabled": true,
      "rate_limit_ms": 0
    }
  ]
}
