{
  "_comment": "数据源同步任务种子：数据源示例工作区。三源一源一表，避免复权口径互相覆盖：baostock（前复权，含成交额，TCP 一次返回整段）→「股市日线」；tencent（前复权，单次约 320 根，按 440 自然日分片）→「股市日线-腾讯」；sina（不复权，仅最近 1023 根）→「股市日线-新浪」。三表标的集合与时间范围一致（2021-10-18 起 10 只 A 股，约 1,200 根/标的），与 StockMaster 线上样本口径对齐。seed 只注入配置（enabled=true）不联网抓取，示例 CSV 由 scripts/build_example_kline.py 生成。股票代码带市场前缀（sh/sz），volume 统一为「股」（腾讯内部由手×100 换算）。各源复权算法不同，跨表比较只看形态不看绝对值。",
  "jobs": [
    {
      "name": "股市日线同步（baostock 前复权）",
      "provider": "baostock_kline",
      "table": "股市日线",
      "request_spec": {
        "url_template": "baostock://kline?frequency=d&adjustflag=2",
        "time_window": {
          "mode": "range",
          "start_param": "start",
          "end_param": "end"
        }
      },
      "entrant_param": "symbol",
      "entrant_keys": [
        "sh600519",
        "sz000858",
        "sz000001",
        "sh600036",
        "sh601318",
        "sz300750",
        "sz002594",
        "sh601899",
        "sh600900",
        "sz000651"
      ],
      "match_keys": ["股票代码", "交易日"],
      "field_mapping": {
        "symbol": { "name": "股票代码", "field_type": "text" },
        "trade_date": { "name": "交易日", "field_type": "date" },
        "open": { "name": "开盘价", "field_type": "float" },
        "high": { "name": "最高价", "field_type": "float" },
        "low": { "name": "最低价", "field_type": "float" },
        "close": { "name": "收盘价", "field_type": "float" },
        "volume": { "name": "成交量", "field_type": "int" },
        "amount": { "name": "成交额", "field_type": "float" }
      },
      "cursor": { "strategy": "date", "field": "交易日", "backfill_start": "2021-10-18" },
      "schedule": { "mode": "daily", "at": "17:30", "timezone": "Asia/Shanghai" },
      "enabled": true,
      "rate_limit_ms": 500
    },
    {
      "name": "股市日线同步（腾讯前复权）",
      "provider": "tencent_kline",
      "table": "股市日线-腾讯",
