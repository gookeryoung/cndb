        },
        "row_defaults": {"来源": "腾讯前复权", "复权方式": "前复权"}
      },
      "entrant_param": "symbol",
      "entrant_keys": [],
      "entrant_source": {"table": "股票清单", "field": "代码", "prefix_in": ["sh68", "sh69"]},
      "match_keys": ["股票代码", "日期", "来源"],
      "field_mapping": {
        "symbol": {"name": "股票代码", "field_type": "text"},
        "日期": {"name": "日期", "field_type": "date"},
        "开盘": {"name": "开盘", "field_type": "float"},
        "收盘": {"name": "收盘", "field_type": "float"},
        "最高": {"name": "最高", "field_type": "float"},
        "最低": {"name": "最低", "field_type": "float"},
        "成交量": {"name": "成交量", "field_type": "number"}
      },
      "cursor": {"strategy": "backfill_date", "field": "日期", "backfill_start": "2016-01-01"},
      "schedule": {"mode": "manual"},
