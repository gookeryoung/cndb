{
  "_comment": "分析模板种子：数据源示例工作区（天气每日 / 股市日线）。键为数据表名（= CSV 文件名），公式字段名须与表字段一致；窗口公式（ma / pct_change）带 partition_by（城市 / 股票代码）与 order_by（日期），与 ADR 0006 M4 的时序窗口语义一致。股市日线样本为 10 只标的 × 近 5 年约 1.2 万行，模板 limit 提到 3000 行（每标的约 300 个交易日）以兼顾覆盖度与前端渲染；腾讯 / 新浪两张对照表不配模板，跨源价格因复权算法不同不可直接比较。",
  "天气每日": [
    {
      "name": "温度趋势与均温线",
      "description": "按城市分区的多线趋势：平均气温折线 + 3 日移动平均平滑短期波动，分组汇总比较各城市整体平均气温。",
      "config": {
        "formulas": [
          {
            "key": "temp_ma3",
            "label": "3日均温",
            "expr": "round(ma([平均气温], 3), 2)",
            "partition_by": "城市",
            "order_by": "日期"
          }
        ],
        "chart": {
          "type": "line",
          "x": "日期",
          "y": "平均气温",
          "series": "城市",
          "title": "各城市平均气温趋势",
          "aggregation": "avg"
        },
        "summary": {
          "group_by": "城市",
          "metrics": [
            {
              "field": "平均气温",
              "agg": "avg",
              "label": "平均气温"
            },
            {
              "field": "城市",
              "agg": "count",
              "label": "记录数"
            }
          ],
          "sort_by": "avg(平均气温)",
          "sort_order": "desc",
          "top_n": 10
        },
        "fields": [
          "城市",
          "日期",
          "最高气温",
          "最低气温",
          "平均气温",
          "降水量"
        ],
        "limit": 3000
      }
    },
    {
      "name": "昼夜温差分析",
      "description": "公式 温差=最高气温−最低气温，折线看逐日温差波动；分组汇总按城市比较平均温差（大陆性 vs 海洋性气候）。",
      "config": {
        "formulas": [
          {
            "key": "temp_range",
            "label": "昼夜温差",
            "expr": "round([最高气温] - [最低气温], 2)",
            "partition_by": "城市",
            "order_by": "日期"
          }
        ],
        "chart": {
          "type": "line",
          "x": "日期",
          "y": "temp_range",
          "series": "城市",
          "title": "昼夜温差趋势",
          "aggregation": "sum"
        },
        "summary": {
          "group_by": "城市",
          "metrics": [
            {
              "field": "temp_range",
              "agg": "avg",
              "label": "平均温差"
            },
            {
              "field": "城市",
              "agg": "count",
              "label": "记录数"
            }
          ],
          "sort_by": "avg(temp_range)",
          "sort_order": "desc",
          "top_n": 10
        },
        "fields": [
          "城市",
          "日期",
          "最高气温",
          "最低气温",
          "平均气温",
          "降水量"
        ],
        "limit": 3000
      }
    },
    {
      "name": "高温日与降水分布",
      "description": "直方图观察最高气温的分布形态（高温日集中区）；分组汇总按城市统计平均最高气温与雨日记录数。",
      "config": {
        "chart": {
          "type": "histogram",
          "x": "最高气温",
          "y": null,
          "series": null,
          "title": "最高气温分布",
          "aggregation": "sum"
        },
        "summary": {
          "group_by": "城市",
          "metrics": [
            {
              "field": "最高气温",
              "agg": "max",
              "label": "极端最高气温"
            },
            {
              "field": "平均气温",
              "agg": "avg",
              "label": "平均气温"
            },
            {
              "field": "城市",
              "agg": "count",
              "label": "记录数"
            }
          ],
          "sort_by": "max(最高气温)",
          "sort_order": "desc",
          "top_n": 10
        },
        "fields": [
          "城市",
          "日期",
          "最高气温",
          "最低气温",
          "平均气温",
          "降水量"
        ],
        "limit": 3000
      }
    }
  ],
  "股市日线": [
    {
      "name": "股价走势与 5 日均线",
      "description": "按股票代码分区的多线趋势：收盘价折线 + 5 日移动平均；分组汇总比较各标的区间均价与交易天数。",
      "config": {
        "formulas": [
          {
            "key": "close_ma5",
            "label": "5日均线",
            "expr": "round(ma([收盘价], 5), 2)",
            "partition_by": "股票代码",
            "order_by": "交易日"
          }
        ],
        "chart": {
          "type": "line",
          "x": "交易日",
          "y": "收盘价",
          "series": "股票代码",
          "title": "收盘价走势",
          "aggregation": "avg"
        },
        "summary": {
          "group_by": "股票名称",
          "metrics": [
            {
              "field": "收盘价",
              "agg": "avg",
              "label": "区间均价"
            },
            {
              "field": "收盘价",
              "agg": "max",
              "label": "区间最高"
            },
            {
              "field": "收盘价",
              "agg": "min",
              "label": "区间最低"
            }
          ],
          "sort_by": "avg(收盘价)",
          "sort_order": "desc",
          "top_n": 10
        },
        "fields": [
          "股票代码",
          "股票名称",
          "交易日",
          "开盘价",
          "最高价",
          "最低价",
          "收盘价",
          "成交量",
          "成交额"
        ],
        "limit": 3000
      }
    },
    {
      "name": "涨跌幅与振幅",
      "description": "窗口函数逐日计算：涨跌幅=pct_change(收盘价)，振幅=(最高−最低)/收盘×100；按股票代码分区避免跨标的串行，汇总比较各标的平均振幅。",
      "config": {
        "formulas": [
          {
            "key": "pct_chg",
            "label": "涨跌幅(%)",
            "expr": "round(pct_change([收盘价]) * 100, 2)",
            "partition_by": "股票代码",
            "order_by": "交易日"
          },
          {
            "key": "amplitude",
            "label": "振幅(%)",
            "expr": "round(([最高价] - [最低价]) / [收盘价] * 100, 2)",
            "partition_by": "股票代码",
            "order_by": "交易日"
          }
        ],
        "chart": {
          "type": "line",
          "x": "交易日",
          "y": "pct_chg",
          "series": "股票代码",
          "title": "每日涨跌幅",
          "aggregation": "sum"
        },
        "summary": {
          "group_by": "股票名称",
          "metrics": [
            {
              "field": "amplitude",
              "agg": "avg",
              "label": "平均振幅(%)"
            },
            {
              "field": "pct_chg",
              "agg": "sum",
              "label": "区间累计涨跌幅(%)"
            },
            {
              "field": "股票名称",
              "agg": "count",
              "label": "交易日数"
            }
          ],
          "sort_by": "avg(amplitude)",
          "sort_order": "desc",
          "top_n": 10
        },
        "fields": [
          "股票代码",
          "股票名称",
          "交易日",
          "开盘价",
          "最高价",
          "最低价",
          "收盘价",
          "成交量",
          "成交额"
        ],
        "limit": 3000
      }
    },
    {
      "name": "量价关系",
      "description": "散点图观察收盘价与成交量的相关关系；分组汇总按股票名称统计区间累计成交额与量能均线。",
      "config": {
        "formulas": [
          {
            "key": "vol_ma5",
            "label": "量能均线(5)",
            "expr": "round(ma([成交量], 5), 2)",
            "partition_by": "股票代码",
            "order_by": "交易日"
          }
        ],
        "chart": {
          "type": "scatter",
          "x": "收盘价",
          "y": "成交量",
          "series": null,
          "title": "量价关系（收盘价 vs 成交量）",
          "aggregation": "sum"
        },
        "summary": {
          "group_by": "股票名称",
          "metrics": [
            {
              "field": "成交额",
              "agg": "sum",
              "label": "区间累计成交额"
            },
            {
              "field": "成交量",
              "agg": "avg",
              "label": "日均成交量"
            },
            {
              "field": "股票名称",
              "agg": "count",
              "label": "交易日数"
            }
          ],
          "sort_by": "sum(成交额)",
          "sort_order": "desc",
          "top_n": 10
        },
        "fields": [
          "股票代码",
          "股票名称",
          "交易日",
          "开盘价",
          "最高价",
          "最低价",
          "收盘价",
          "成交量",
          "成交额"
        ],
        "limit": 3000
      }
    }
  ]
}
