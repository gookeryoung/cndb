{
  "_comment": "分析模板种子：数据源示例工作区（天气每日）。键为数据表名（= CSV 文件名），公式字段名须与表字段一致；窗口公式（ma / pct_change）带 partition_by（城市）与 order_by（日期），与 ADR 0006 M4 的时序窗口语义一致。模板 limit 设为 3000 行以兼顾覆盖度与前端渲染。",
  "天气每日": [
    {
      "name": "温度趋势与均温线",
      "description": "按城市分区的多线趋势：平均气温折线 + 3 日移动平均平滑短期波动，分组汇总比较各城市整体平均气温。",
      "config": {
        "formulas": [
          {
            "key": "temp_ma3",
            "label": "3日均温",
            "expr": "round(ma([平均气温], 3), 2)",
            "partition_by": "城市",
            "order_by": "日期"
          }
        ],
        "chart": {
          "type": "line",
          "x": "日期",
          "y": "平均气温",
          "series": "城市",
          "title": "各城市平均气温趋势",
          "aggregation": "avg"
        },
        "summary": {
          "group_by": "城市",
          "metrics": [
            {
              "field": "平均气温",
              "agg": "avg",
              "label": "平均气温"
            },
            {
              "field": "城市",
              "agg": "count",
              "label": "记录数"
            }
          ],
          "sort_by": "avg(平均气温)",
          "sort_order": "desc",
          "top_n": 10
        },
        "fields": [
          "城市",
          "日期",
          "最高气温",
          "最低气温",
          "平均气温",
          "降水量"
        ],
        "limit": 3000
      }
    },
    {
      "name": "昼夜温差分析",
      "description": "公式 温差=最高气温−最低气温，折线看逐日温差波动；分组汇总按城市比较平均温差（大陆性 vs 海洋性气候）。",
      "config": {
        "formulas": [
          {
            "key": "temp_range",
            "label": "昼夜温差",
            "expr": "round([最高气温] - [最低气温], 2)",
            "partition_by": "城市",
            "order_by": "日期"
          }
        ],
        "chart": {
          "type": "line",
          "x": "日期",
          "y": "temp_range",
          "series": "城市",
          "title": "昼夜温差趋势",
          "aggregation": "sum"
        },
        "summary": {
          "group_by": "城市",
          "metrics": [
            {
              "field": "temp_range",
              "agg": "avg",
              "label": "平均温差"
            },
            {
              "field": "城市",
              "agg": "count",
              "label": "记录数"
            }
          ],
          "sort_by": "avg(temp_range)",
          "sort_order": "desc",
          "top_n": 10
        },
        "fields": [
          "城市",
          "日期",
          "最高气温",
          "最低气温",
          "平均气温",
          "降水量"
        ],
        "limit": 3000
      }
    },
    {
      "name": "高温日与降水分布",
      "description": "直方图观察最高气温的分布形态（高温日集中区）；分组汇总按城市统计平均最高气温与雨日记录数。",
      "config": {
        "chart": {
          "type": "histogram",
          "x": "最高气温",
          "y": null,
          "series": null,
          "title": "最高气温分布",
          "aggregation": "sum"
        },
        "summary": {
          "group_by": "城市",
          "metrics": [
            {
              "field": "最高气温",
              "agg": "max",
              "label": "极端最高气温"
            },
            {
              "field": "平均气温",
              "agg": "avg",
              "label": "平均气温"
            },
            {
              "field": "城市",
              "agg": "count",
              "label": "记录数"
            }
          ],
          "sort_by": "max(最高气温)",
          "sort_order": "desc",
          "top_n": 10
        },
        "fields": [
          "城市",
          "日期",
          "最高气温",
          "最低气温",
          "平均气温",
          "降水量"
        ],
        "limit": 3000
      }
    }
  ]
}
