{
  "_comment": "低质量数据视图种子配置：四张 CSV 极端数据表（xlsx 样例为手动导入数据，不参与 seed 建表，不配视图）各配一个多图图表视图，用于验证图表在低质量数据下的健壮性——日期多格式与非法日期整桶归未分组、大量级窄区间分箱标签可辨识（labelPrecision 自适应精度）、boolean 维度按 是/否 归桶、COUNT 聚合剔除空值行、负值与全角数字聚合不崩；另为三张表补 calendar/matrix/kanban 视图覆盖更多视图模式。",
  "16-日期格式大全": [
    {
      "name": "全部日期行",
      "view_type": "grid",
      "is_default": true,
      "order": 0
    },
    {
      "name": "日期格式解析概览",
      "view_type": "chart",
      "view_options": {
        "charts": [
          {
            "chart_type": "bar",
            "dimension_field": "ISO日期",
            "date_granularity": "year",
            "measure_field": "非法日期",
            "aggregation": "count",
            "show_stats_panel": true
          },
          {
            "chart_type": "bar",
            "dimension_field": "斜杠日期",
            "date_granularity": "quarter",
            "measure_field": "非法日期",
            "aggregation": "count",
            "show_stats_panel": true
          },
          {
            "chart_type": "bar",
            "dimension_field": "紧凑日期",
            "date_granularity": "week",
            "measure_field": "非法日期",
            "aggregation": "count",
            "show_stats_panel": true
          },
          {
            "chart_type": "line",
            "dimension_field": "美式日期",
            "date_granularity": "day",
            "measure_field": "非法日期",
            "aggregation": "count",
            "show_stats_panel": true
          },
          {
            "chart_type": "line",
            "dimension_field": "中文日期",
            "date_granularity": "month",
            "measure_field": "非法日期",
            "aggregation": "count",
            "show_stats_panel": true
          }
        ]
      },
      "order": 1
    },
    {
      "name": "日期解析日历",
      "view_type": "calendar",
      "view_options": {
        "start_field": "ISO日期"
      },
      "order": 2
    }
