{
  "_comment": "股票信息管理 — API 建表配置（腾讯实时快照）",
  "_version": "1.0",
  "_provider": "腾讯行情接口 qt.gtimg.cn",
  "_notes": "腾讯股票 API 返回 GBK 编码的 v_xxx=\"a~b~c~...\" 格式，使用 tencent_stock 处理器解析",

  "tables": [
    {
      "table_name": "A股典型个股行情",
      "description": "10支典型A股的实时行情快照（腾讯接口）",
      "fetch": {
        "url": "https://qt.gtimg.cn/q=sh600519,sz000001,sh601318,sh600036,sz000858,sh601398,sz000333,sh600276,sz300750,sh688981",
        "method": "GET",
        "headers": {
          "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        },
        "response_handler": "tencent_stock",
        "encoding": "gbk",
        "timeout": 15,
        "query_interval": 60
      },
      "views": [
        {
          "name": "按市值排序",
          "view_type": "grid",
          "filter_type": "AND",
          "sortings": [
            {"field_name": "total_mv", "direction": "desc"}
          ],
          "field_order": [
            "symbol", "stock_name", "current_price", "change_percent",
            "open_price", "high_price", "low_price", "volume_lots",
            "amount_wan", "total_mv", "timestamp"
          ],
          "field_options": {
            "change_percent": {"prefix": "", "suffix": "%", "decimal_places": 2},
            "current_price": {"decimal_places": 2},
            "total_mv": {"prefix": "", "suffix": "亿", "decimal_places": 2},
            "amount_wan": {"suffix": "万", "decimal_places": 0}
          },
          "order": 0,
          "is_default": true
        },
        {
          "name": "涨幅排行",
          "view_type": "grid",
          "sortings": [
            {"field_name": "change_percent", "direction": "desc"}
          ],
          "field_order": [
            "symbol", "stock_name", "current_price", "change_percent",
            "high_price", "low_price", "amplitude", "timestamp"
          ],
          "order": 1
        },
        {
          "name": "成交额TOP",
          "view_type": "grid",
          "sortings": [
            {"field_name": "amount_wan", "direction": "desc"}
          ],
          "field_order": [
            "symbol", "stock_name", "current_price", "volume_lots",
            "amount_wan", "circulating_mv", "turnover_rate", "timestamp"
          ],
          "order": 2
        }
      ]
    }
  ]
}
