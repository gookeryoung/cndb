// 四轮小车（rover）：复杂系统 → 组件 → 零件三级装配典型示例
// 层级：system rover → assembly chassis / axle / wheel → group（布尔）→ part（图元）
param body_len = 120
param body_w = 60
param body_t = 8
param wheel_d = 40
param wheel_w = 16
param axle_d = 10

// 组件级：车轮（轮辋减轮毂孔，module 可复用 / 可实例化）
module wheel(d, w) {
  rotate([90, 0, 0])
    difference {
      cyl(d = d, h = w)
      translate([0, 0, -1]) cyl(d = d * 0.35, h = w + 2)
    }
}

// 组件级：车轴（空心圆管，轴向转水平）
module axle(d, len) {
  rotate([90, 0, 0]) tube(od = d, id = d * 0.6, h = len)
}

// 组件级：底盘（带中心过孔的板）
module chassis(len, w, t) {
  difference {
    box(size = [len, w, t])
    translate([0, 0, -1]) cyl(d = 14, h = t + 2)
  }
}

// 系统级：复杂系统装配声明（顶层根，不可实例化）
system rover {
  chassis(body_len, body_w, body_t)

  translate([body_len / 2 - 18, 0, 0]) axle(axle_d, body_w + 2 * wheel_w)
  translate([body_len / 2 - 18, body_w / 2 + wheel_w / 2, 0]) wheel(wheel_d, wheel_w)
  translate([body_len / 2 - 18, -body_w / 2 - wheel_w / 2, 0]) wheel(wheel_d, wheel_w)

  translate([-body_len / 2 + 18, 0, 0]) axle(axle_d, body_w + 2 * wheel_w)
  translate([-body_len / 2 + 18, body_w / 2 + wheel_w / 2, 0]) wheel(wheel_d, wheel_w)
  translate([-body_len / 2 + 18, -body_w / 2 - wheel_w / 2, 0]) wheel(wheel_d, wheel_w)

  translate([0, 0, body_t + 42]) sphere(r = 14)   // 零件级细节：传感器球头
}
