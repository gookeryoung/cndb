{
  "_comment": "dashboard view_options 契约用例（ADR 0023 I1）：Python 与前端 TS 共用同一份，防止口径漂移。valid 断言解析成功且二次归一幂等；invalid 断言错误定位到 path。",
  "fields": {
    "订单号": "text",
    "商品类别": "text",
    "销售额": "number",
    "数量": "number",
    "日期": "date",
    "评分": "float",
    "支付方式": "select"
  },
  "valid": [
    {
      "name": "空配置补默认值",
      "config": {}
    },
    {
      "name": "柱状图基础",
      "config": {
        "schema_version": 1,
        "widgets": [
          {
            "id": "sales-by-category",
            "type": "chart",
            "title": "各类目销售额",
            "layout": {"x": 0, "y": 0, "w": 6, "h": 10},
            "query": {"filters": [], "sortings": []},
            "chart": {"type": "bar", "x": "商品类别", "y": ["销售额"], "agg": "sum"}
          }
        ]
      }
    },
    {
      "name": "折线多系列与格式",
      "config": {
        "widgets": [
          {
            "id": "trend",
            "type": "chart",
            "layout": {"x": 0, "y": 0, "w": 12, "h": 10},
            "chart": {
              "type": "line",
              "x": "日期",
              "y": ["销售额", "数量"],
              "series": "支付方式",
              "agg": "sum",
              "stack": "percent",
              "sort": "desc",
              "top_n": 10,
              "dual_axis": true,
              "format": {"unit": "元", "decimals": 2}
            }
          }
        ]
      }
    },
    {
      "name": "饼图",
      "config": {
        "widgets": [
          {
            "id": "pie",
            "type": "chart",
            "layout": {"x": 0, "y": 0, "w": 4, "h": 8},
            "chart": {"type": "pie", "x": "商品类别", "y": ["销售额"]}
          }
        ]
      }
    },
    {
      "name": "散点图双数值轴",
      "config": {
        "widgets": [
          {
            "id": "scatter",
            "type": "chart",
            "layout": {"x": 0, "y": 0, "w": 6, "h": 8},
            "chart": {"type": "scatter", "x": "数量", "y": ["销售额"], "agg": "sum"}
          }
        ]
      }
    },
    {
      "name": "直方图无 X 轴",
      "config": {
        "widgets": [
          {
            "id": "hist",
            "type": "chart",
            "layout": {"x": 0, "y": 0, "w": 6, "h": 8},
            "chart": {"type": "histogram", "y": ["销售额"]}
          }
        ]
      }
    },
    {
      "name": "箱线图",
      "config": {
        "widgets": [
          {
            "id": "box",
            "type": "chart",
            "layout": {"x": 0, "y": 0, "w": 6, "h": 8},
            "chart": {"type": "boxplot", "x": "商品类别", "y": ["销售额"]}
          }
        ]
      }
    },
    {
      "name": "KPI 周期对比与迷你趋势",
      "config": {
        "widgets": [
          {
            "id": "kpi-sales",
            "type": "kpi",
            "layout": {"x": 0, "y": 0, "w": 3, "h": 4},
            "kpi": {
              "value": {"field": "销售额", "agg": "sum"},
              "compare": {"mode": "prev_period", "date_field": "日期", "granularity": "month"},
              "sparkline": {"field": "销售额", "agg": "sum", "points": 12}
            }
          }
        ]
      }
    },
    {
      "name": "KPI 文本字段计数",
      "config": {
        "widgets": [
          {
            "id": "kpi-count",
            "type": "kpi",
            "layout": {"x": 0, "y": 0, "w": 3, "h": 4},
            "kpi": {"value": {"field": "订单号", "agg": "count"}}
          }
        ]
      }
    },
    {
      "name": "文本组件",
      "config": {
        "widgets": [
          {
            "id": "note",
            "type": "text",
            "layout": {"x": 0, "y": 0, "w": 12, "h": 3},
            "text": {"content": "口径说明：销售额按订单金额汇总，含退款。"}
          }
        ]
      }
    },
    {
      "name": "表格组件",
      "config": {
        "widgets": [
          {
            "id": "detail",
            "type": "table",
            "layout": {"x": 0, "y": 0, "w": 12, "h": 10},
            "table": {"columns": ["订单号", "商品类别", "销售额"], "row_limit": 20}
          }
        ]
      }
    },
    {
      "name": "扁平画布键兼容",
      "config": {
        "row_height": 32,
        "gap": 8,
        "padding": 12,
        "widgets": []
      }
    },
    {
      "name": "全局筛选与设置",
      "config": {
        "widgets": [],
        "global_filters": [
          {"id": "date", "kind": "date_range", "field": "日期", "label": "日期"},
          {"id": "pay", "kind": "select", "field": "支付方式"},
          {"id": "kw", "kind": "search", "field": "商品类别"}
        ],
        "settings": {"refresh_interval": 30, "theme": "light"}
      }
    },
    {
      "name": "未知键裁剪",
      "config": {
        "unknown_root": "x",
        "widgets": [
          {
            "id": "trim",
            "type": "text",
            "unknown_widget": "x",
            "layout": {"x": 0, "y": 0, "w": 12, "h": 3},
            "text": {"content": "说明"}
          }
        ]
      }
    },
    {
      "name": "组件级过滤与排序",
      "config": {
        "widgets": [
          {
            "id": "filtered",
            "type": "chart",
            "layout": {"x": 0, "y": 0, "w": 6, "h": 8},
            "query": {
              "filters": [
                {"field_name": "销售额", "op": ">=", "value": 100},
                {"field_name": "商品类别", "op": "in", "value": ["数码", "家电"]}
              ],
              "filter_logic": "OR",
              "sortings": [{"field_name": "销售额", "direction": "desc"}],
              "limit": 200
            },
            "chart": {"type": "bar", "x": "商品类别", "y": ["销售额"]}
          }
        ]
      }
    }
  ],
