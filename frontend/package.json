{
  "name": "cndb-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "analyze": "vite build --mode analyze",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "bundle:budget:update": "node scripts/bundle-budget.mjs --update",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit --incremental",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --fix",
    "check": "pnpm typecheck && pnpm lint",
    "e2e": "playwright test",
    "e2e:affected": "node scripts/e2e-affected.mjs",
    "e2e:setup": "playwright test --project=setup",
    "e2e:smoke": "playwright test --project=chromium-authed tests/e2e/smoke",
    "e2e:critical": "playwright test --project=chromium-authed tests/e2e/critical",
    "e2e:headed": "playwright test --headed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage.mjs",
    "test:coverage:html": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html && node scripts/check-coverage.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.12",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-virtual": "^3.14.21",
    "antd": "^5.29.3",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "driver.js": "^1.10.1",
    "echarts": "^6.1.0",
    "html2canvas-pro": "^2.5.2",
    "jspdf": "^4.2.1",
    "nunjucks": "^3.2.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "simple-statistics": "^7.12.1",
    "web-vitals": "^6.2.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-testing-library": "^7.16.2",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.4.2"
}
