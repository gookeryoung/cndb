{
  "name": "cndb-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm typecheck && pnpm lint",
    "e2e": "playwright test",
    "e2e:setup": "playwright test --project=setup",
    "e2e:smoke": "playwright test --project=chromium-authed tests/e2e/smoke",
    "e2e:critical": "playwright test --project=chromium-authed tests/e2e/critical",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.0",
    "@tanstack/react-query": "^5.62.0",
    "@xyflow/react": "^12.3.0",
    "antd": "^5.22.0",
    "axios": "^1.7.0",
    "dayjs": "^1.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0"
  }
}