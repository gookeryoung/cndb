diff --git a/es/index.js b/es/index.js
index ede2f7e6c52174ac15bfe1af5c951aee0c12d034..7cab1153508bdbc24102580d8b5ddc0d2451609a 100644
--- a/es/index.js
+++ b/es/index.js
@@ -1,4 +1,19 @@
-import * as React from 'react';
+// 补丁（见 frontend/patches/rc-field-form@2.7.1.patch）—— 目的：让 rc-field-form 可被摇树。
+// 上游两处问题会让 antd 里仅 `import { FormProvider } from 'rc-field-form'`
+// （antd/es/form/context.js）就把 Form / useForm / Field / validateUtil /
+// @rc-component/async-validator 全量拉进首屏主入口（实测 190→185 KiB gzip）：
+//   1) package.json 未声明 "sideEffects"，Rollup 只能保守保留每个 import；
+//   2) 本文件在模块顶层给默认导出挂静态属性（RefForm.FormProvider = …），
+//      属性赋值被判定为副作用，整桶无法裁剪。
+// 改法：package.json 补 "sideEffects": false；本文件去掉静态属性挂载（改为纯 re-export）。
+//
+// ⚠️ 默认导出必须保留 React.forwardRef 包装：antd 的 Form 通过 ref 取表单实例
+//    （useImperativeHandle / formRef）。去掉包装会让 antd 报
+//    「Function components cannot be given refs」，并在交互时报
+//    「Cannot add property current, object is not extensible」—— 登录页直接不可用。
+// 安全性：antd 在自己的 Form 上重新挂 Item / List / useForm / useWatch / Provider，
+//    默认导出的静态属性在本仓库无人使用；该库模块导入无副作用。
+import * as React from "react";
 import Field from "./Field";
 import List from "./List";
 import useForm from "./useForm";
@@ -7,12 +22,6 @@ import { FormProvider } from "./FormContext";
 import FieldContext from "./FieldContext";
 import ListContext from "./ListContext";
 import useWatch from "./useWatch";
-var InternalForm = /*#__PURE__*/React.forwardRef(FieldForm);
-var RefForm = InternalForm;
-RefForm.FormProvider = FormProvider;
-RefForm.Field = Field;
-RefForm.List = List;
-RefForm.useForm = useForm;
-RefForm.useWatch = useWatch;
+var RefForm = /*#__PURE__*/React.forwardRef(FieldForm);
 export { Field, List, useForm, FormProvider, FieldContext, ListContext, useWatch };
 export default RefForm;
