# 版本控制
.git
.gitignore
.github

# Python 缓存与构建产物
__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info
*.egg
# 注意：Docker 不支持行尾注释，每条规则必须是纯 pattern。
# 仅排除 sdist，保留 dist/*.whl 供 deploy/Dockerfile.prod 使用。
dist/*.tar.gz
# 离线交付包输出（导出脚本产物，构建上下文不需要，且体积达数百 MB）
dist/offline
build
.eggs

# 测试与覆盖率
.pytest_cache
.coverage
htmlcov
.tox
coverage.xml

# ── 前端 ──
# 生产镜像由 PyPI wheel 安装（前端已内嵌），镜像内不再构建前端；
# 排除 node_modules 等目录仅为缩小构建上下文体积。
frontend/node_modules
frontend/dist
frontend/coverage
frontend/.auth
frontend/playwright-report
frontend/test-results
frontend/.eslintcache
.pnpm-store

# 本地开发数据库与数据目录（容器内用 /data卷，不要把宿主数据打进镜像）
.cndb

# 工作区元数据
.workbuddy
.trae
.claude

# 虚拟环境
.venv
venv
env

# 工具缓存
.uv-cache
.ruff_cache
.pyrefly_cache
.mypy_cache

# IDE 与编辑器
.idea
.vscode
*.swp
*.swo

# 文档（按需保留）
docs

# 系统文件
.DS_Store
Thumbs.db
