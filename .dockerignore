# 版本控制
.git
.gitignore
.github

# Python 缓存与构建产物
__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info
*.egg
# 注意：Docker 不支持行尾注释，每条规则必须是纯 pattern。
# 仅排除 sdist，保留 dist/*.whl 供deploy/Dockerfile.wheel 使用。
dist/*.tar.gz
build
.eggs

# 测试与覆盖率
.pytest_cache
.coverage
htmlcov
.tox
coverage.xml

# ── 前端（deploy/Dockerfile 会在镜像内重新 pnpm install）──
# node_modules 约 500MB，排除后构建上下文从~700MB 降到 ~10MB；
# 不能排除整个 frontend/，镜像构建需要 frontend/ 源码与 pnpm-lock.yaml。
frontend/node_modules
frontend/dist
frontend/coverage
frontend/.auth
frontend/playwright-report
frontend/test-results
frontend/.eslintcache
.pnpm-store

# 本地开发数据库与数据目录（容器内用 /data卷，不要把宿主数据打进镜像）
.cndb

# 工作区元数据
.workbuddy
.trae
.claude

# 虚拟环境
.venv
venv
env

# 工具缓存
.uv-cache
.ruff_cache
.pyrefly_cache
.mypy_cache

# IDE 与编辑器
.idea
.vscode
*.swp
*.swo

# 文档（按需保留）
docs

# 系统文件
.DS_Store
Thumbs.db
