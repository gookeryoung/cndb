    "@tarojs/plugin-platform-weapp": "4.0.11",
    "@tarojs/react": "4.0.11",
    "@tarojs/runtime": "4.0.11",
    "@tarojs/shared": "4.0.11",
    "@tarojs/taro": "4.0.11",
    "dayjs": "^1.11.13",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@tarojs/cli": "4.0.11",
    "@tarojs/webpack5-runner": "4.0.11",
    "@types/node": "^22.10.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
