# ═══════════════════════════════════════════════════════════════════
# CNB 流水线基础环境镜像
#
# 为什么不用官方镜像直接跑：
#   本项目门禁需要 python3.12 + uv + node22 + pnpm + docker CLI + 中文字体，
#   每个 job 现场安装约 60~90s，且装在每个容器里重复付费。
#   固化到镜像后由 CNB 缓存（docker.build 层缓存），命中时几乎零成本启动。
#
# 同时作为 docker:cache 的缓存镜像源：
#   .cnb.yml 中 `type: docker:cache` 依赖本文件按 by/versionBy 生成缓存镜像，
#   Dockerfile 本身不变即直接命中，不重建。
# ═══════════════════════════════════════════════════════════════════

FROM docker.m.daocloud.io/library/node:22-bookworm-slim

# ── 国内镜像源 + 工具链 ──
# fonts-wqy-*：reportlab 生成中文 PDF 必需，缺失会渲染方框
# Debian bookworm 起 apt 源改为 deb822 格式
# （/etc/apt/sources.list.d/debian.sources），不再有 /etc/apt/sources.list。
# 用 [ -f ] 判存在再替换：GNU sed 遇到缺失文件会直接报错退出（它没有 -o 选项，
# 那是 rsync 的），不加判断整层必然失败。
# 两条路径都处理，使同一份命令兼容 bookworm 与更老的 slim 镜像。
RUN set -eux; \
    for f in /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources; do \
      if [ -f "$f" ]; then \
        sed -i -e 's|deb.debian.org|mirrors.aliyun.com|g' \
               -e 's|security.debian.org|mirrors.aliyun.com|g' "$f"; \
      fi; \
    done; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates curl git openssh-client build-essential pkg-config \
      fontconfig fonts-wqy-microhei fonts-wqy-zenhei; \
    fc-cache -fv; \
    rm -rf /var/lib/apt/lists/*

# ── Docker CLI（仅客户端）──
# tag 流水线要 buildx 构建并推镜像，但 daemon 由 .cnb.yml 的 services: [docker] 提供。
# 这里用官方静态二进制而非 apt 的 docker.io：后者会连带装完整 daemon（~250MB），
# 既臃肿又和外部 daemon 冲突。
ARG DOCKER_VERSION=27.5.1
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) D_ARCH=x86_64 ;; \
      arm64) D_ARCH=aarch64 ;; \
      *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    base="https://download.docker.com/linux/static/stable/${D_ARCH}"; \
    curl -fsSL "$base/docker-${DOCKER_VERSION}.tgz" -o /tmp/docker.tgz; \
    tar -xzf /tmp/docker.tgz -C /tmp; \
    install -m 0755 /tmp/docker/docker /usr/local/bin/docker; \
    # buildx 插件（docker buildx 子命令）
    mkdir -p /root/.docker/cli-plugins; \
    curl -fsSL "https://github.com/docker/buildx/releases/download/v${DOCKER_VERSION}/buildx-v${DOCKER_VERSION}.linux-${D_ARCH}" \
      -o /root/.docker/cli-plugins/docker-buildx; \
    chmod 0755 /root/.docker/cli-plugins/docker-buildx; \
    rm -rf /tmp/docker /tmp/docker.tgz; \
    docker --version; docker buildx version

# ── uv + Python 3.12 ──
# 基础镜像 node:22-bookworm-slim 不含任何 Python，
# 必须显式装 3.12（项目 requires-python = ">=3.12"）。
# 交给 uv 管理而非 apt：apt 在 bookworm 只有 3.11，且版本会随发行版漂移。
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
 && ln -sf /root/.local/bin/uv /usr/local/bin/uv \
 && ln -sf /root/.local/bin/uvx /usr/local/bin/uvx \
 && uv python install 3.12

# ── pnpm（须与 frontend/package.json 的 packageManager 字段一致）──
RUN npm i -g pnpm@12.4.2

# ── 缓存目录：全部走 docker.volumes 的 copy-on-write 节点缓存 ──
ENV UV_CACHE_DIR=/root/.cache/uv \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/workspace/.venv \
    PNPM_HOME=/root/.local/share/pnpm \
    npm_config_store_dir=/root/.local/share/pnpm/store \
    CI=true \
    PYTHONIOENCODING=utf-8 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

WORKDIR /workspace